# Copy this file to .env and fill in real values.
# .env is never committed (see .gitignore).

# Supabase connection string (Session pooler), psycopg3 driver:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Key used to sign the session cookie. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Initial admin credentials (seeded only once).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Set to "true" in production (Render serves over HTTPS) so the session
# cookie is only sent over HTTPS. Defaults to false so local development
# over http://localhost keeps working.
SESSION_HTTPS_ONLY=false
