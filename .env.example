# Copia este archivo a .env y completa los valores reales.
# .env nunca se commitea (ver .gitignore).

# Connection string de Supabase (Session pooler), driver psycopg3:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Clave para firmar la cookie de sesión. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Credenciales del usuario admin inicial (se siembra una sola vez).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
