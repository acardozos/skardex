# Copy this file to .env and fill in real values.
# .env is never committed (see .gitignore).

# Connection string, psycopg3 driver. The default points at the local
# development database started with `docker compose up -d --wait db`.
#
# NEVER put the production (Supabase) URL in this file: it lives only in the
# Render environment. Running migrations, the app or a container against
# production from a laptop changes production data and can break the running
# container (its start command applies migrations it may not know about).
# For a one-off command against production, pass the URL inline instead:
#   DATABASE_URL='postgresql+psycopg://...' uv run python -m skardex.<command>
DATABASE_URL=postgresql+psycopg://skardex:skardex@127.0.0.1:5433/skardex_dev

# Key used to sign the session cookie. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Initial admin credentials (seeded only once).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Only set this temporarily, to recover a forgotten admin password with
# `uv run python -m skardex.reset_admin_password`. The admin must choose a new
# password at the next login. Remove it afterwards.
# ADMIN_RESET_PASSWORD=

# Set to "true" in production (Render serves over HTTPS) so the session
# cookie is only sent over HTTPS. Defaults to false so local development
# over http://localhost keeps working.
SESSION_HTTPS_ONLY=false
